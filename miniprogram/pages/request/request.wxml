<!--pages/request/request.wxml-->
<text>pages/request/request.wxml</text>
<view class="home-top">
  <view class="home-swiper">
    <swiper indicator-dots="true" autoplay="true" interval="5000" duration="1000" indicator-color="#ffffff" 
    indicator-active-color="#2971f6" style="height: 400px;">
      <block wx:for="{{ top_stories }}" wx:key="*this">
        <swiper-item>
          <view class="weui-media-box__title">{{ item.title }}</view>
          <image src="{{ item.image }}" style="width: 100%;" class="slide-image" mode="widthFix"></image>
        </swiper-item>
      </block>
    </swiper>
  </view>
</view>
<view class="page__bd">
  <view class="weui-panel weui-panel_access">
    <view class="weui-panel__bd" wx:for="{{ stories }}" wx:for-item="story" wx:key="*item">
      <navigator url="" class="weui-media-box_appmsg" hover-class="weui-cell_active">
        <view class="weui-media-box__hd weui-media-box__hd_in-appmsg">
          <image class="weui-media-box__thumb" mode="widthFix" src="{{ story.images[0] }}" 
          style="height: auto;"></image>
        </view>
        <view class="weui-media-box__bd weui-media-box__bd_in-appmsg">
          <view class="weui-media-box__title">{{ story.title }}</view>
        </view>
      </navigator>
    </view>
  </view>
</view>
<button bind:tap="axiosTest">云函数获取网络数据</button>
<button bind:tap="getOpenID">云函数获取OpenID</button>